# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Tool caches
.pytest_cache/
.ruff_cache/

# Secrets and local configuration: .env.example carries the shape, never the values
.env
.envrc

# What a run produces. The published copies of these live on gh-pages, built by
# scripts/publish-showcase.sh — none of them belongs in the history of the code
# that produces them.
data/
media/
videos/
traces/
*.sqlite3
allure-results*/
allure-report/
site/

# The worktrees and the staging directory scripts/publish-showcase.sh uses while it
# assembles the site
published/
publish-tree/
publish-data/

