# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# Tool caches
.pytest_cache/
.ruff_cache/

# Secrets and local configuration: .env.example carries the shape, never the values
.env
.envrc

# What a run produces. The published copies of these are assembled by
# scripts/build-showcase.sh and deployed to GitHub Pages from the CI run — none of
# them belongs in the history of the code that produces them.
data/
media/
videos/
traces/
*.sqlite3
allure-results*/
allure-report/
site/

# The staging directory scripts/build-showcase.sh uses while it assembles the site
publish-data/

