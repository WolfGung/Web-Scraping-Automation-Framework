# Copy to .env and change what you need to. Every setting has a working default —
# the suite and the CLI both run with no .env at all — so this file only documents
# what SCRAPEWATCH_* controls; it carries no real values.

# Storage URL. SQLite by default so the repository works after one clone; Compose's
# postgres profile points this at postgresql+psycopg://scrapewatch:scrapewatch@postgres:5432/scrapewatch
# instead (see docker-compose.yml, service scrape-pg).
SCRAPEWATCH_DB_URL=sqlite:///data/scrapewatch.sqlite3

# Seconds a PoliteClient waits between two requests to the same host. Politeness,
# not throughput — this is a website someone else pays to keep online.
SCRAPEWATCH_MIN_REQUEST_INTERVAL_S=0.5

# How many times PoliteClient retries a dropped connection or a 5xx before giving up.
SCRAPEWATCH_MAX_RETRIES=3

# Seconds before an HTTP request is considered hung.
SCRAPEWATCH_REQUEST_TIMEOUT_S=20.0

# Sent on every HTTP request and every browser page, so a site operator reading
# their own logs can tell what this is and how to reach the project.
SCRAPEWATCH_USER_AGENT=scrapewatch/0.1 (+https://github.com/WolfGung/Web-Scraping-Automation-Framework)

# Browser sources only (quotes). Off by default; the nightly run turns it on for a
# post-mortem when a site changes shape.
SCRAPEWATCH_RECORD_VIDEO=false

# Where a recorded browser session's video is written, when SCRAPEWATCH_RECORD_VIDEO=true.
SCRAPEWATCH_VIDEO_DIR=videos

# Where a recorded browser session's trace (.zip) is written, when SCRAPEWATCH_RECORD_VIDEO=true.
SCRAPEWATCH_TRACE_DIR=traces

# Whether BrowserSession launches Chromium headless. false only makes sense on a
# machine with a display, for watching a run live while debugging it.
SCRAPEWATCH_HEADLESS=true

# Base URL of the demo store: what `scrape demo` reads from, and what `demo-store`
# serves on. Compose's scrape/scrape-pg services point this at the demo-store
# service (http://demo-store:8765); a local run defaults to loopback.
SCRAPEWATCH_DEMO_URL=http://127.0.0.1:8765
